---
import { site } from '../data/site';
---

<!-- na mobile je telefón stále po ruke, pri poruche je to hlavná akcia -->
<div class="call">
  <a class="btn" href={site.phoneHref}>Zavolať elektrikárovi</a>
</div>

<style>
  .call {
    display: none;
  }
  @media (max-width: 820px) {
    .call {
      position: fixed;
      inset: auto 0 0 0;
      z-index: 10;
      display: block;
      padding: 0.75rem 1.25rem;
      border-top: 1px solid var(--line);
      background: var(--bg);
    }
    .btn {
      display: block;
      text-align: center;
    }
    /* aby pätičku nezakrývala pevná lišta */
    :global(body) {
      padding-bottom: 5rem;
    }
  }
</style>
