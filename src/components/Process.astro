---
import { steps } from '../data/site';
---

<section id="postup" class="section">
  <div class="wrap">
    <header class="sec-head">
      <p class="label">02 · Postup</p>
      <h2>Ako to prebieha</h2>
    </header>
    <!-- číslovanie je na mieste, lebo kroky sú skutočná postupnosť.
         Kroky sú svorky X1–X4 na jednej svorkovnici, spojené vodičom. -->
    <ol class="steps">
      {
        steps.map((s, i) => (
          <li>
            <span class="term" aria-hidden="true">
              X{i + 1}
            </span>
            <strong>{s.title}</strong>
            <span class="text">{s.text}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    --gap: 2rem;
    --term: 3rem;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--gap);
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
  }
  li {
    position: relative;
  }
  /* vodič k ďalšej svorke */
  li:not(:last-child)::after {
    content: '';
    position: absolute;
    top: calc(var(--term) / 2 - 1px);
    left: var(--term);
    right: calc(var(--gap) * -1);
    height: 2px;
    background: var(--ink);
  }
  .term {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: var(--term);
    height: var(--term);
    margin-bottom: 1.25rem;
    border: 1.5px solid var(--ink);
    background: var(--paper);
    font: 500 0.85rem/1 var(--mono);
    letter-spacing: 0.04em;
  }
  strong {
    display: block;
    margin-bottom: 0.4rem;
    font: 700 1.4rem/1.15 var(--head);
  }
  .text {
    display: block;
    color: var(--muted);
    max-width: 32ch;
  }

  @media (max-width: 820px) {
    .steps {
      --gap: 1.75rem;
      grid-template-columns: minmax(0, 1fr);
      margin-top: 2rem;
    }
    li {
      padding-left: calc(var(--term) + 1.1rem);
      min-height: var(--term);
    }
    .term {
      position: absolute;
      top: 0;
      left: 0;
      margin: 0;
    }
    li:not(:last-child)::after {
      top: var(--term);
      bottom: calc(var(--gap) * -1);
      left: calc(var(--term) / 2 - 1px);
      right: auto;
      width: 2px;
      height: auto;
    }
  }
</style>
