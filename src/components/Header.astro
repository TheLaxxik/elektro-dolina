---
import { site } from '../data/site';

const nav = [
  { href: '#sluzby', code: '01', label: 'Služby' },
  { href: '#postup', code: '02', label: 'Postup' },
  { href: '#cennik', code: '03', label: 'Cenník' },
  { href: '#kontakt', code: '04', label: 'Kontakt' },
];
---

<header>
  <div class="wrap bar">
    <a class="logo" href="#" aria-label={`${site.name}, na začiatok`}>
      <svg width="22" height="28" viewBox="0 0 32 32" aria-hidden="true">
        <rect x="7" y="2" width="18" height="28" rx="3" fill="#f2c200" stroke="currentColor" stroke-width="2"></rect>
        <rect x="11" y="8" width="10" height="11" rx="1" fill="currentColor"></rect>
        <rect x="12" y="9" width="8" height="5" rx="1" fill="#e9ecee"></rect>
        <rect x="11" y="23" width="10" height="3" fill="#2f9e4f"></rect>
      </svg>
      <span>{site.name}</span>
    </a>

    <!-- čísla zodpovedajú číslam listov pri nadpisoch sekcií -->
    <nav aria-label="Sekcie stránky">
      <ul>
        {
          nav.map((n) => (
            <li>
              <a href={n.href}>
                <span class="code" aria-hidden="true">{n.code}</span>
                {n.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="right">
      <div class="contact">
        <a class="tel" href={site.phoneHref}>{site.phone}</a>
        <small>Po–So 7:00–19:00</small>
      </div>
      <!-- ikona ukazuje režim, na ktorý sa prepne: mesiac = tmavý, slnko = svetlý -->
      <button class="theme" type="button" data-theme-toggle aria-label="Prepnúť na tmavý režim">
        <svg class="sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg class="moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
      </button>
    </div>
  </div>
  <!-- zelenožltá = ochranný vodič, rovnaký znak ako na vodičoch v rozvádzači -->
  <div class="pe" aria-hidden="true"></div>
</header>

<script>
  import '../scripts/theme';
</script>

<style>
  header {
    background: var(--paper);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0.9rem 0;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font: 700 1.4rem/1 var(--head);
    text-decoration: none;
    white-space: nowrap;
  }

  ul {
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.5rem 0.7rem;
    font: 600 0.95rem/1 var(--body);
    text-decoration: none;
  }
  nav a:hover {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
  .code {
    color: var(--muted);
    font: 500 0.7rem/1 var(--mono);
    letter-spacing: 0.06em;
  }

  .right {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .contact {
    text-align: right;
  }
  .tel {
    font: 700 1.3rem/1 var(--head);
    text-decoration: none;
    white-space: nowrap;
  }
  .tel:hover {
    text-decoration: underline;
  }
  small {
    display: block;
    margin-top: 0.3rem;
    color: var(--muted);
    font: 500 0.7rem/1 var(--mono);
    letter-spacing: 0.06em;
  }

  .theme {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    appearance: none;
  }
  .theme:hover {
    background: var(--bg);
  }
  .sun {
    display: none;
  }
  :global(:root[data-theme='dark']) .theme .sun {
    display: block;
  }
  :global(:root[data-theme='dark']) .theme .moon {
    display: none;
  }

  .pe {
    height: 4px;
    background: repeating-linear-gradient(90deg, #2e9b4a 0 28px, #f2c200 28px 56px);
  }

  @media (max-width: 980px) {
    nav {
      display: none;
    }
  }
  @media (max-width: 820px) {
    small {
      display: none;
    }
  }
  @media (max-width: 480px) {
    /* číslo je na mobile v pevnej spodnej lište, v hlavičke by sa s prepínačom nezmestilo */
    .contact {
      display: none;
    }
  }
</style>
