---
import { prices } from '../data/site';
---

<section id="cennik" class="section">
  <div class="wrap">
    <header class="sec-head">
      <p class="label">03 · Cenník</p>
      <h2>Orientačný cenník</h2>
    </header>
    <div class="pricing">
      <p class="intro">Ukážkové ceny. Konečnú cenu vždy určí obhliadka a dostanete ju písomne.</p>
      <!-- tabuľka v štýle kusovníka z výkresu -->
      <table>
        <caption class="sr-only">Orientačný cenník</caption>
        <thead>
          <tr>
            <th scope="col" class="label pos">Poz.</th>
            <th scope="col" class="label">Položka</th>
            <th scope="col" class="label num">Cena</th>
          </tr>
        </thead>
        <tbody>
          {
            prices.map((p, i) => (
              <tr>
                <td class="pos">{String(i + 1).padStart(2, '0')}</td>
                <th scope="row">{p.item}</th>
                <td class="num">{p.price}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .pricing {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    gap: 1.5rem;
    align-items: start;
    margin-top: 2rem;
  }
  .intro {
    color: var(--muted);
  }
  table {
    width: 100%;
    border-collapse: collapse;
    border: 1px solid var(--rule);
    background: var(--paper);
  }
  th,
  td {
    padding: 1rem 1.1rem;
    border-bottom: 1px solid var(--line);
    vertical-align: baseline;
    text-align: left;
  }
  thead th {
    padding-block: 0.6rem;
    border-bottom: 1px solid var(--rule);
  }
  tbody tr:last-child > * {
    border-bottom: 0;
  }
  tbody th {
    font-weight: 400;
  }
  .pos {
    width: 4.5rem;
    border-right: 1px solid var(--line);
    color: var(--muted);
    font: 500 0.8rem/1.2 var(--mono);
  }
  thead .pos {
    font-size: 0.75rem;
  }
  .num {
    text-align: right;
    white-space: nowrap;
  }
  tbody .num {
    font: 700 1.3rem/1.2 var(--head);
  }
  @media (max-width: 820px) {
    .pricing {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
      margin-top: 1rem;
    }
    th,
    td {
      padding-inline: 0.75rem;
    }
    .pos {
      width: 2.75rem;
    }
  }
</style>
