---
import { site, prepare } from '../data/site';
---

<section id="kontakt" class="band">
  <div class="wrap two">
    <div>
      <h2>Zavolajte alebo napíšte SMS</h2>
      <a class="phone" href={site.phoneHref}>{site.phone}</a>
      <p class="mail"><a href={`mailto:${site.email}`}>{site.email}</a></p>
      <p>V správe uveďte, čo treba spraviť, kde a kedy vám to vyhovuje. Ozveme sa v ten istý deň.</p>
    </div>
    <div>
      <h2>Kde pracujeme</h2>
      <p>{site.area}</p>
      <h3>Pri poruche si pripravte</h3>
      <ul>
        {prepare.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .band {
    padding: 4.5rem 0;
    background: var(--band);
    color: var(--band-ink);
  }
  .two {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 4rem;
  }
  .band :focus-visible {
    outline-color: var(--signal);
  }
  .phone {
    display: inline-block;
    margin-bottom: 0.5rem;
    color: var(--signal);
    font: 700 clamp(2.2rem, 7vw, 3.8rem) / 1.05 var(--head);
    text-decoration: none;
    white-space: nowrap;
  }
  .phone:hover {
    text-decoration: underline;
    text-underline-offset: 0.12em;
  }
  .mail {
    margin-bottom: 1.5rem;
    font-size: 1.15rem;
  }
  p {
    color: var(--band-muted);
  }
  .mail,
  .mail a {
    color: var(--band-ink);
  }
  h3 {
    margin: 1.5rem 0 0.6rem;
    font-size: 1.2rem;
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--band-muted);
  }
  li {
    position: relative;
    padding: 0.2rem 0 0.2rem 1.25rem;
  }
  li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.85em;
    width: 0.5rem;
    height: 0.5rem;
    background: var(--signal);
  }
  @media (max-width: 820px) {
    .band {
      padding: 3.25rem 0;
    }
    .two {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.75rem;
    }
  }
</style>
