---
import { site, prepare } from '../data/site';
---

<!-- Kontakt je celý jedno veľké "Zavolať": preto signálna žltá, rovnako ako tlačidlo.
     Žltá je fixná v oboch režimoch, text na nej je vždy tmavý. -->
<section id="kontakt" class="band">
  <div class="wrap">
    <header class="head">
      <p class="code">04 · Kontakt</p>
      <h2>Zavolajte alebo napíšte SMS</h2>
    </header>

    <a class="phone" href={site.phoneHref}>{site.phone}</a>

    <div class="cols">
      <div>
        <p class="hours">{site.hours}</p>
        <p class="mail"><a href={`mailto:${site.email}`}>{site.email}</a></p>
        <p>V správe uveďte, čo treba spraviť, kde a kedy vám to vyhovuje. Ozveme sa v ten istý deň.</p>
      </div>
      <div>
        <h3>Kde pracujeme</h3>
        <p>{site.area}</p>
      </div>
      <div>
        <h3>Pri poruche si pripravte</h3>
        <ul>
          {prepare.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .band {
    margin-top: 2rem;
    padding: 4rem 0 4.5rem;
    background: var(--signal);
    color: var(--signal-ink);
  }
  .band :focus-visible {
    outline-color: var(--signal-ink);
  }
  .head {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    gap: 1.5rem;
    align-items: baseline;
    padding-top: 1rem;
    border-top: 1.5px solid var(--signal-ink);
  }
  .code {
    margin: 0;
    font: 500 0.75rem/1.3 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  h2 {
    margin: 0;
  }
  .phone {
    display: block;
    margin: 2.5rem 0 3rem;
    font: 700 clamp(2.3rem, 10.5vw, 8.5rem) / 0.9 var(--head);
    letter-spacing: -0.025em;
    text-decoration: none;
    white-space: nowrap;
  }
  .phone:hover {
    text-decoration: underline;
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.08em;
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(17, 28, 38, 0.35);
  }
  p {
    margin-bottom: 0.75rem;
  }
  .hours {
    font-weight: 600;
  }
  .mail {
    font-size: 1.15rem;
  }
  .mail a {
    text-underline-offset: 0.2em;
  }
  h3 {
    margin-bottom: 0.6rem;
    font-size: 1.3rem;
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    position: relative;
    padding: 0.2rem 0 0.2rem 1.25rem;
  }
  li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.85em;
    width: 0.5rem;
    height: 0.5rem;
    background: var(--signal-ink);
  }
  @media (max-width: 820px) {
    .band {
      padding: 3rem 0 3.25rem;
    }
    .head {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.6rem;
    }
    .phone {
      margin: 1.75rem 0 2rem;
    }
    .cols {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.75rem;
    }
  }
</style>
