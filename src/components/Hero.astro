---
import Switchboard from './Switchboard.astro';
import { site, facts } from '../data/site';

const cols = ['A', 'B', 'C', 'D', 'E', 'F'];
---

<!-- Hero je list technického výkresu: rám so súradnicami, rohová pečiatka
     s faktami a rozvádzač ako hlavný "obrázok" výkresu. -->
<section class="sheet" aria-labelledby="hero-title">
  <div class="wrap">
    <div class="frame">
      <div class="ruler" aria-hidden="true">
        {cols.map((c) => <span>{c}</span>)}
      </div>

      <div class="top">
        <div class="copy">
          <p class="label">Elektroinštalácie · Košice a okolie</p>
          <h1 id="hero-title">Elektrikár v Košiciach a okolí</h1>
          <p class="lead">
            Rozvody, rozvádzače, revízie a poruchy. Obhliadka je zadarmo a cenu dostanete písomne ešte pred začiatkom
            práce.
          </p>
          <div class="actions">
            <a class="btn" href={site.phoneHref}>Zavolať {site.phone}</a>
            <a class="more" href="#cennik">Pozrieť cenník</a>
          </div>
        </div>

        <!-- rohová pečiatka výkresu -->
        <div class="stamp">
          <div class="stamp-title">
            <strong>{site.name}</strong>
            <span class="label" aria-hidden="true">List 01</span>
          </div>
          <dl>
            {
              facts.map((f) => (
                <div>
                  <dt class="label">{f.label}</dt>
                  <dd>{f.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>

      <div id="sluzby" class="figure">
        <div class="fig-head">
          <h2>Čo robíme</h2>
          <p class="label">Obr. 1 · Rozvádzač, zapnite istič</p>
        </div>
        <Switchboard />
      </div>
    </div>
  </div>
</section>

<style>
  .sheet {
    padding: 2.5rem 0 1rem;
  }
  .frame {
    position: relative;
    padding: 0 2.25rem 2.25rem;
    border: 1px solid var(--rule);
    background-color: var(--paper);
    /* milimetrový papier, len jemne */
    background-image:
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 24px 24px;
    background-position: -1px -1px;
  }

  /* súradnice výkresu A–F pozdĺž horného okraja */
  .ruler {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    margin: 0 -2.25rem 2.75rem;
    border-bottom: 1px solid var(--rule);
  }
  .ruler span {
    padding: 0.3rem 0;
    border-left: 1px solid var(--line);
    color: var(--muted);
    font: 500 0.68rem/1 var(--mono);
    text-align: center;
  }
  .ruler span:first-child {
    border-left: 0;
  }

  .top {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    gap: 3rem;
    align-items: end;
  }
  h1 {
    margin-top: 1rem;
    font-size: clamp(2.8rem, 7.4vw, 5.6rem);
    line-height: 0.94;
    letter-spacing: -0.02em;
  }
  .lead {
    margin: 1.5rem 0 2rem;
    font-size: 1.2rem;
    max-width: 46ch;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
  }
  .more {
    padding: 1rem 0;
    font-weight: 600;
    text-underline-offset: 0.25em;
  }

  /* pečiatka: tabuľka s ostrými čiarami ako v rohu výkresu */
  .stamp {
    border: 1px solid var(--rule);
    background: var(--paper);
  }
  .stamp-title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.8rem 0.9rem;
    border-bottom: 1px solid var(--rule);
  }
  .stamp-title strong {
    font: 700 1.35rem/1 var(--head);
  }
  dl {
    margin: 0;
  }
  dl > div {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.6rem 0.9rem;
  }
  dl > div + div {
    border-top: 1px solid var(--line);
  }
  dd {
    margin: 0;
    font: 600 1.05rem/1.25 var(--head);
  }

  .figure {
    margin-top: 3.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
    scroll-margin-top: 1rem;
  }
  .fig-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-bottom: 1.25rem;
  }
  .fig-head h2 {
    margin: 0;
  }

  @media (max-width: 900px) {
    .top {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.25rem;
    }
  }
  @media (max-width: 820px) {
    .sheet {
      padding-top: 1.25rem;
    }
    .frame {
      padding: 0 1.1rem 1.5rem;
    }
    .ruler {
      margin: 0 -1.1rem 2rem;
    }
    .figure {
      margin-top: 2.5rem;
    }
  }
  @media (max-width: 480px) {
    /* na úzkom displeji sa číslo do tlačidla nezmestí, je aj v spodnej lište */
    .btn {
      width: 100%;
      text-align: center;
    }
  }
</style>
