---
import Switchboard from './Switchboard.astro';
import { site } from '../data/site';
---

<div class="wrap hero">
  <div class="copy">
    <h1>Elektrikár v Košiciach a okolí</h1>
    <p class="lead">
      Rozvody, rozvádzače, revízie a poruchy. Obhliadka je zadarmo a cenu dostanete písomne ešte pred začiatkom práce.
    </p>
    <div class="actions">
      <a class="btn" href={site.phoneHref}>Zavolať</a>
      <a class="more" href="#cennik">Pozrieť cenník</a>
    </div>
  </div>
  <Switchboard />
</div>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
    gap: 3.5rem;
    align-items: start;
    padding: 3.5rem 0 4.5rem;
  }
  h1 {
    font-size: clamp(2.5rem, 6vw, 4.2rem);
    line-height: 1;
  }
  .lead {
    margin: 1.5rem 0 2rem;
    font-size: 1.15rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
  }
  .more {
    padding: 1rem 0;
    font-weight: 600;
    text-underline-offset: 0.25em;
  }
  @media (max-width: 820px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
      padding: 2.25rem 0 3rem;
    }
  }
</style>
